{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "storylandai",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storyland-db",
      "database_id": "513c1bc1-454e-49ce-be8a-a93e8380283c"
    }
  ]
}
