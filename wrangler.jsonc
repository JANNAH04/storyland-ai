{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "storylandai",
  "main": "worker.js",
  "account_id": "b165ae6764d735a6c3d77ee3a0137f58",
  "compatibility_date": "2026-10-27",

  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storyland-db",
      "database_id": "513c1bc1-454e-49ce-be8a-a93e8380283c"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "IMAGES_KV",
      "id": "ID_KV_AWAK"
    }
  ]
}